# Copy to .env and fill. NEVER commit .env.
# Anthropic — used only via blackbox/llm.py (cached).
ANTHROPIC_API_KEY=

# Bright Data — claimed at the venue (~17:30). The fetch layer (blackbox/net.py)
# degrades silently to plain httpx when these are absent.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=

# Set to 1 to make llm.py return deterministic fixtures (used by tests).
LLM_MOCK=0
